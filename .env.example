# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==============================================================================
# DHILIPHOME SERVER CONFIGURATION (.env)
# ==============================================================================

# Server Network Binding
# 0.0.0.0 binds to all available network interfaces (Localhost + LAN Wi-Fi/Ethernet)
HOST=0.0.0.0

# Server HTTP Port (Default: 8080)
PORT=8080

# Environment mode: production or development
ENVIRONMENT=production

# Storage and Directories
# Absolute or relative path to the media storage directory accessible to clients
MEDIA_ROOT=./media

# SQLite Database storage location
DATABASE_PATH=./data/dhiliphome.db

# Server Activity and Error Log file path
LOG_PATH=./logs/server.log

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Security & Authentication
# Secret key used for signing session tokens and internal security hashes
DHILIPHOME_SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Initial administrator username seeded on first database initialization
DHILIPHOME_ADMIN_USERNAME=admin

# Initial administrator password (must be changed after initial setup)
DHILIPHOME_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Token expiration in seconds (default: 604800 = 7 days)
AUTH_TOKEN_EXPIRY_SECONDS=604800

# LAN Discovery & Realtime
# UDP broadcast port used for Android client automatic LAN discovery
DISCOVERY_UDP_PORT=8888

# Background system stats broadcast interval in seconds (2 to 5 seconds)
SYSTEM_UPDATE_INTERVAL=3

# CORS allowed origins (Use '*' for all LAN clients or specify explicit origins)
CORS_ORIGINS=*

# Max file upload size in megabytes (Default: 500 MB)
MAX_CONTENT_LENGTH_MB=500

